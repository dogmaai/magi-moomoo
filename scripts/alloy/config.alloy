// config.alloy — Grafana Alloy configuration for TIALA host metrics.
//
// Decision (magi-core#667): collect with prometheus.exporter.unix — it
// emits node_* series (node-exporter dashboards and the disk-usage alert
// work), unlike scraping netdata. Live-verified on TIALA 2026-10-26:
// node_filesystem_*, node_cpu_seconds_total, node_memory_*, node_load*,
// node_network_*, node_disk_* all reach grafanacloud-aka-prom.
//
// This file is checked into a public repository, so it carries NO
// secrets. Credentials come from the process environment — the brew
// wrapper (alloy-wrapper) sources /opt/homebrew/etc/alloy/config.env,
// which in turn sources ~/.config/magi-moomoo/alloy.env (mode 600).
//
// Required env vars (see install-alloy-launchagent.sh):
//   GRAFANA_ALLOY_REMOTE_WRITE_TOKEN  glc_ token, metrics:write only
//   GRAFANA_PROM_REMOTE_WRITE_USER    Hosted Metrics instance ID (NOT the
//                                     stack ID — see secrets-inventory.md)

prometheus.exporter.unix "tiala" {
	include_exporter_metrics = true

	filesystem {
		mount_points_exclude = "^/(dev|private/var/vm|System/Volumes/VM)($|/)"
		fs_types_exclude     = "^(devfs|autofs|map|synthetic|vmfs)$"
	}
}

prometheus.scrape "tiala" {
	targets         = prometheus.exporter.unix.tiala.targets
	forward_to      = [prometheus.relabel.tiala.receiver]
	scrape_interval = "60s"
}

// Stamp host identity onto every series.
prometheus.relabel "tiala" {
	forward_to = [prometheus.remote_write.grafanacloud.receiver]

	rule {
		target_label = "instance"
		replacement  = "tiala"
	}
	rule {
		target_label = "host"
		replacement  = "tiala"
	}
	rule {
		target_label = "job"
		replacement  = "tiala-host"
	}
}

prometheus.remote_write "grafanacloud" {
	endpoint {
		url = "https://prometheus-prod-49-prod-ap-northeast-0.grafana.net/api/prom/push"

		basic_auth {
			username = sys.env("GRAFANA_PROM_REMOTE_WRITE_USER")
			password = sys.env("GRAFANA_ALLOY_REMOTE_WRITE_TOKEN")
		}
	}

	wal {
		truncate_frequency = "2h"
	}
}
